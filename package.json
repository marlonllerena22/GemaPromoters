{
  "name": "gemapromoters",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "npm run start --prefix backend",
    "seed": "npm run seed --prefix backend",
    "finance:preview": "node backend/scripts/finance-preview.mjs",
    "finance:mobile-preview": "node backend/scripts/finance-mobile-preview.mjs",
    "finance:test": "node --test backend/test/finance.test.js backend/test/finance-quick.test.js backend/test/finance-mobile-preview.test.js backend/test/marjorie-promoters.test.js backend/test/ticketing-transfer.test.js",
    "finance:backup": "node backend/scripts/finance-backup.mjs",
    "finance:smoke": "node backend/scripts/finance-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
