# Configure these through your hosting secret manager, not in source control.
FINANCE_ADMIN_USER=finanzas
FINANCE_ADMIN_NAME=Administrador
# Required only to bootstrap the first owner. At least 12 characters; use a unique generated password.
FINANCE_ADMIN_PASSWORD=
# Required in production for encrypted receipts and authenticators. Use a stable random secret >=32 characters.
# Back up this key independently. Changing or losing it prevents decryption of previous records.
FINANCE_DOCUMENT_KEY=
# Optional, used server-side only. No real provider calls are made without configuration.
OPENAI_API_KEY=
FINANCE_OPENAI_MODEL=gpt-5.4-mini
# Independent HMAC secret for AlfaBusiness deliveries, at least 32 random characters.
FINANCE_SALES_WEBHOOK_SECRET=
FINANCE_INTERNAL_SYNC_ENABLED=1
# Optional override for an audited legacy dataset. Empty means server-local timezone for naive timestamps.
# Render's default runtime is UTC; an original dataset created locally may differ.
FINANCE_LEGACY_TIMESTAMP_OFFSET=
# Private destination for complete verified SQLite backups.
FINANCE_BACKUP_DIR=
# Existing app settings (configure real values separately).
DB_PATH=
JWT_SECRET=
# Never enable FINANCE_DEMO in production. The preview launcher uses an independent demo database.
